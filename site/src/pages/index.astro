---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const resources = (await getCollection('resources')).sort((a, b) => a.id.localeCompare(b.id));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Bóveda de recursos">
  <section class="hero wrap">
    <p class="kicker">resource vault</p>
    <h1>Recursos de aprendizaje, <em>archivados para estudiarlos</em>.</h1>
    <p class="lede">
      Cursos, guías y kits guardados como datos estructurados —no como capturas—
      con navegación completa, notas del instructor y modo oscuro.
      La data manda: cada recurso es Markdown + YAML versionable.
    </p>
  </section>

  <section class="wrap" aria-labelledby="recursos">
    <div class="section-title">
      <h2 id="recursos">Recursos</h2>
      <span class="count">{resources.length} archivado{resources.length === 1 ? '' : 's'}</span>
    </div>
    <div style="display:grid;gap:1rem;">
      {resources.map((r) => (
        <a class="res-card" href={`${base}/r/${r.id}/`}>
          <div class="meta">
            <span class="pill">{r.data.type}</span>
            {r.data.tags.slice(0, 4).map((t: string) => <span class="pill">#{t}</span>)}
          </div>
          <h3>{r.data.title}</h3>
          <p class="summary">{r.data.summary}</p>
          <p class="summary" style="font-size:var(--fs--1);color:var(--muted);">
            {r.data.parts.length} partes · fuente original: {new URL(r.data.source.url).hostname}
          </p>
          <span class="cta">Abrir recurso →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap" aria-labelledby="como">
    <div class="section-title"><h2 id="como">¿Cómo agrego un recurso?</h2></div>
    <div class="prose" style="font-size:var(--fs-0);color:var(--ink-2);">
      <p>
        Cada recurso vive en <code>resources/&lt;id&gt;/</code> con un manifiesto
        <code>resource.yaml</code> y partes en Markdown. La especificación completa está en
        <code>docs/SCHEMA.md</code> y hay plantillas en <code>resources/_templates/</code>.
        Si el build pasa, el recurso cumple el esquema: el visor lo renderiza sin tocar código.
      </p>
    </div>
  </section>
</Base>
