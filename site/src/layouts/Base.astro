---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/inter-tight';
import '@fontsource-variable/jetbrains-mono';
import '../styles/base.css';
import '../styles/deck.css';
import '../styles/site.css';

export interface Props {
  title: string;
  description?: string;
  /** hide default site header (deck pages have their own chrome) */
  bare?: boolean;
}

const { title, description = 'Bóveda de recursos de aprendizaje: cursos, guías y kits en formato estructurado.', bare = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Resource Vault</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf8f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141920" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      // theme before paint — no flash
      (() => {
        const saved = localStorage.getItem('vault:theme');
        if (saved) document.documentElement.dataset.theme = saved;
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Saltar al contenido</a>
    {!bare && (
      <header class="site-head">
        <div class="wrap site-head__row">
          <a class="brand" href={`${base}/`}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M4 7.5 12 3l8 4.5v9L12 21l-8-4.5v-9Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
              <path d="M4.4 7.8 12 12l7.6-4.2M12 12v8.6" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
            </svg>
            <span>resource<strong>vault</strong></span>
          </a>
          <button class="btn btn--icon" id="theme-toggle" aria-label="Cambiar tema claro/oscuro">
            <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.8"/>
              <path d="M12 2.5v2.4M12 19.1v2.4M2.5 12h2.4M19.1 12h2.4M5 5l1.7 1.7M17.3 17.3 19 19M19 5l-1.7 1.7M6.7 17.3 5 19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
            <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M20 13.5A8.5 8.5 0 0 1 10.5 4 8.5 8.5 0 1 0 20 13.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      </header>
    )}
    <main id="main">
      <slot />
    </main>
    {!bare && (
      <footer class="site-foot">
        <div class="wrap">
          <p>Data first: el contenido vive en <code>resources/</code> como Markdown+YAML. Este sitio es solo el visor.</p>
          <p>Contenido curado con atribución a sus autores originales — uso de estudio personal.</p>
        </div>
      </footer>
    )}
    <script>
      // theme toggle
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const current = root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        localStorage.setItem('vault:theme', next);
      });
      // copy buttons on every pre>code
      document.querySelectorAll('.prose pre, .slide__body pre').forEach((pre) => {
        const btn = document.createElement('button');
        btn.className = 'copy-btn';
        btn.textContent = 'copiar';
        btn.setAttribute('aria-label', 'Copiar código');
        btn.addEventListener('click', async () => {
          await navigator.clipboard.writeText(pre.querySelector('code')?.textContent ?? pre.textContent ?? '');
          btn.textContent = '✓ copiado';
          btn.classList.add('copied');
          setTimeout(() => { btn.textContent = 'copiar'; btn.classList.remove('copied'); }, 1600);
        });
        pre.appendChild(btn);
      });
    </script>
  </body>
</html>
